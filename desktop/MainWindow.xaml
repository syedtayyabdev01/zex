<Window x:Class="Zex.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="ZEX for Windows" Icon="{StaticResource ZexWindowIcon}" Width="1280" Height="820"
        MinWidth="900" MinHeight="600" WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowDark}"
        Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="ToolbarRow" Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="Toolbar" Grid.Row="0" Margin="18,14,18,10" Padding="12,9"
                CornerRadius="24" BorderThickness="1" BorderBrush="#7AFFFFFF">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#A05B5B63" Offset="0" />
                    <GradientStop Color="#B5222228" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ZEX" Foreground="{StaticResource ZexRed}" FontSize="24"
                               FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,18,0" />
                    <Border Width="1" Height="28" Background="#66FFFFFF" Margin="0,0,12,0" />
                    <Button x:Name="BackButton" Content="←  Back" ToolTip="Go back (Alt+Left)" Click="Back_Click" />
                    <Button Content="⌂  Home" ToolTip="Go to ZEX home (Ctrl+H)" Click="Home_Click" />
                    <Button Content="↻  Reload" ToolTip="Reload (Ctrl+R)" Click="Reload_Click" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="ZEX  ·  PC 0.1.1" Foreground="#C6C6CC"
                           FontSize="12" VerticalAlignment="Center" Margin="16,0,10,0" />
            </Grid>
        </Border>

        <wv2:WebView2 x:Name="Browser" Grid.Row="1" Margin="0"
                      CoreWebView2InitializationCompleted="Browser_InitializationCompleted" />

        <Grid x:Name="NetworkErrorPanel" Grid.Row="1" Visibility="Collapsed" Margin="30">
            <Border Background="#F01C1C22" BorderBrush="#55FFFFFF" BorderThickness="1"
                    CornerRadius="22" Padding="34" MaxWidth="620" HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="ZEX couldn’t connect" Foreground="White" FontSize="25"
                               FontWeight="SemiBold" TextAlignment="Center" />
                    <TextBlock x:Name="NetworkErrorText" Text="Check your internet connection and try again."
                               Foreground="#C8C8D0" FontSize="15" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,14,0,22" />
                    <Button Content="Try again" Click="RetryNavigation_Click"
                            HorizontalAlignment="Center" MinWidth="130" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="RuntimeErrorPanel" Grid.Row="1" Visibility="Collapsed" Margin="30">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="640">
                <TextBlock Text="ZEX needs Microsoft Edge WebView2 Runtime" Foreground="White"
                           FontSize="26" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Text="Install the free WebView2 Runtime, then reopen ZEX. It is usually already installed with Microsoft Edge."
                           Foreground="#B8B8C0" FontSize="16" TextAlignment="Center" TextWrapping="Wrap" Margin="0,14,0,22" />
                <Button Content="Get WebView2 Runtime" Click="InstallRuntime_Click" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
